@model EcoRutas.Web.Models.UsuarioIndexViewModel
@using Microsoft.AspNet.Identity
@using EcoRutas.Web.Models
@{
    ViewBag.Title = "Usuarios";
    var miId = User.Identity.GetUserId();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Usuarios</h2>
    @Html.ActionLink("Nuevo usuario", "Create", null, new { @class = "btn btn-success" })
</div>

@using (Html.BeginForm("Index", "Usuarios", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-5">
        @Html.TextBoxFor(m => m.Busqueda, new { @class = "form-control", placeholder = "Buscar por nombre, correo o código" })
    </div>
    <div class="col-md-2">
        <select name="rol" class="form-select">
            <option value="" @(string.IsNullOrEmpty(Model.Rol) ? "selected" : "")>Todos los roles</option>
            @foreach (var r in UsuarioFormViewModel.Roles)
            {
                <option value="@r.Key" @(Model.Rol == r.Key ? "selected" : "")>@r.Value</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="estado" class="form-select">
            <option value="" @(string.IsNullOrEmpty(Model.Estado) ? "selected" : "")>Todos</option>
            <option value="activos" @(Model.Estado == "activos" ? "selected" : "")>Activos</option>
            <option value="inactivos" @(Model.Estado == "inactivos" ? "selected" : "")>Inactivos</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-outline-dark">Filtrar</button>
        @Html.ActionLink("Limpiar", "Index", null, new { @class = "btn btn-link" })
    </div>
}

@if (!Model.Usuarios.Any())
{
    <div class="alert alert-info">No hay usuarios que coincidan con el filtro.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Última conexión</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Usuarios)
                {
                    var esYo = u.Id == miId;
                    <tr>
                        <td>@u.CodigoUsuario</td>
                        <td>
                            @u.NombreCompleto
                            @if (esYo)
                            {
                                <span class="badge bg-info text-dark">Usted</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>@UsuarioFormViewModel.NombreRol(u.Rol)</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td>@(u.UltimaConexion.HasValue ? u.UltimaConexion.Value.ToString("dd/MM/yyyy HH:mm") : "Nunca")</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("Editar", "Edit", new { id = u.Id }, new { @class = "btn btn-sm btn-outline-secondary" })

                            @if (!esYo)
                            {
                                using (Html.BeginForm("CambiarEstado", "Usuarios", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="activo" value="@((!u.Activo).ToString().ToLower())" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">@(u.Activo ? "Inactivar" : "Activar")</button>
                                }

                                <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar"
                                        data-bs-toggle="modal" data-bs-target="#modalEliminar"
                                        data-id="@u.Id" data-nombre="@u.NombreCompleto">
                                    Eliminar
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Modal de confirmación para eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Eliminar", "Usuarios", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="eliminarId" />
                <div class="modal-header">
                    <h5 class="modal-title">Eliminar usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    ¿Seguro que desea eliminar al usuario <strong id="eliminarNombre"></strong>?
                    Solo se puede eliminar si no tiene salidas, reservas ni reseñas. Si las tiene, inactívelo.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(".btn-eliminar").on("click", function () {
            $("#eliminarId").val($(this).data("id"));
            $("#eliminarNombre").text($(this).data("nombre"));
        });
    </script>
}

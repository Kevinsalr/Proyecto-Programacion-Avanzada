@model EcoRutas.Web.Models.UsuarioFormViewModel
@{
    ViewBag.Title = "Editar usuario";
}

<h2>Editar usuario</h2>
<p class="text-muted">Código: <strong>@Model.CodigoUsuario</strong></p>

@using (Html.BeginForm("Edit", "Usuarios", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.CodigoUsuario)

    @Html.Partial("_UsuarioCampos", Model)

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Guardar cambios</button>
        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-link" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

@model IList<EcoRutas.Service.DTOs.TourCatalogoDto>
@{
    ViewBag.Title = "Inicio";
}

<section class="portada rounded-3 p-5 mb-4">
    <h1 class="display-5 fw-bold">EcoRutas</h1>
    <p class="lead mb-4">Tours ecológicos con guías locales: caminatas, canopy, avistamiento de aves y rafting.</p>

    @Html.ActionLink("Ver catálogo", "Index", "Catalogo", null, new { @class = "btn btn-light btn-lg me-2" })

    @if (User.IsInRole("Asociado"))
    {
        @Html.ActionLink("Mis reservas", "Index", "Reservas", null, new { @class = "btn btn-outline-light btn-lg" })
    }
    else if (User.IsInRole("Guia"))
    {
        @Html.ActionLink("Mis salidas", "Index", "Guia", null, new { @class = "btn btn-outline-light btn-lg" })
    }
    else if (User.IsInRole("Administrador"))
    {
        @Html.ActionLink("Administrar tours", "Index", "Tours", null, new { @class = "btn btn-outline-light btn-lg" })
    }
    else if (!Request.IsAuthenticated)
    {
        @Html.ActionLink("Crear cuenta", "Register", "Account", null, new { @class = "btn btn-outline-light btn-lg" })
    }
</section>

@if (Model.Any())
{
    <h3 class="mb-3">Próximas salidas</h3>
    <div class="row g-4">
        @foreach (var t in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm tarjeta-tour">
                    @if (t.ImagenPrincipalId.HasValue)
                    {
                        <img src="@Url.Action("Imagen", "Tours", new { id = t.ImagenPrincipalId })" class="card-img-top" alt="@t.Nombre" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@t.Nombre</h5>
                        <p class="text-muted small mb-3">
                            @t.Categoria · Próxima salida: @t.ProximaSalida.Value.ToString("dd/MM/yyyy HH:mm")
                        </p>
                        @Html.ActionLink("Ver salidas", "Detalle", "Catalogo", new { id = t.Id }, new { @class = "btn btn-outline-success mt-auto" })
                    </div>
                </div>
            </div>
        }
    </div>
}

@model EcoRutas.Web.Models.TourFormViewModel

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<div class="row g-3">
    <div class="col-md-4">
        @Html.LabelFor(m => m.Codigo, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Codigo, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-8">
        @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-danger" })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.Descripcion, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Descripcion, 4, 20, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Descripcion, "", new { @class = "text-danger" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(m => m.Categoria, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.Categoria,
            new SelectList(EcoRutas.Web.Models.TourFormViewModel.Categorias, Model.Categoria),
            "-- Seleccione --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.Dificultad, new { @class = "form-label" })
        @Html.DropDownListFor(m => m.Dificultad,
            new SelectList(EcoRutas.Web.Models.TourFormViewModel.Dificultades, Model.Dificultad),
            "-- Seleccione --", new { @class = "form-select" })
        @Html.ValidationMessageFor(m => m.Dificultad, "", new { @class = "text-danger" })
    </div>
    <div class="col-md-4">
        @Html.LabelFor(m => m.DuracionMinutos, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.DuracionMinutos, new { @class = "form-control", type = "number", min = "1" })
        @Html.ValidationMessageFor(m => m.DuracionMinutos, "", new { @class = "text-danger" })
    </div>

    <div class="col-12">
        @Html.LabelFor(m => m.PuntoEncuentro, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.PuntoEncuentro, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.PuntoEncuentro, "", new { @class = "text-danger" })
    </div>

    <div class="col-12">
        <div class="form-check">
            @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
            @Html.LabelFor(m => m.Activo, new { @class = "form-check-label" })
        </div>
    </div>
</div>

@model EcoRutas.Service.DTOs.TourDetalleDto

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">Salidas programadas</h4>
    @Html.ActionLink("Nueva salida", "Create", "Salidas", new { tourId = Model.Id }, new { @class = "btn btn-success btn-sm" })
</div>

@if (!Model.Salidas.Any())
{
    <div class="alert alert-info">Este tour todavía no tiene salidas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Fecha y hora</th>
                    <th>Guía</th>
                    <th class="text-end">Precio por persona</th>
                    <th class="text-center">Cupos (disp. / máx.)</th>
                    <th class="text-center">Reservas confirmadas</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Salidas)
                {
                    <tr>
                        <td>@s.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@s.GuiaNombre</td>
                        <td class="text-end">@s.PrecioXPersona.ToString("N2")</td>
                        <td class="text-center">@s.CuposDisponibles / @s.CupoMax</td>
                        <td class="text-center">@s.ReservasConfirmadas</td>
                        <td>
                            @if (s.ListaCerrada)
                            {
                                <span class="badge bg-dark">Lista cerrada</span>
                            }
                            else if (s.Activa)
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (!s.ListaCerrada)
                            {
                                @Html.ActionLink("Editar", "Edit", "Salidas", new { id = s.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            }
                            @using (Html.BeginForm("Eliminar", "Salidas", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Eliminar esta salida?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <input type="hidden" name="tourId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@model EcoRutas.Web.Models.TourFormViewModel
@{
    ViewBag.Title = "Editar tour";
}

<h2>Editar tour</h2>
<p class="text-muted">Las imágenes se administran desde el detalle del tour.</p>

@using (Html.BeginForm("Edit", "Tours", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    @Html.Partial("_TourCampos", Model)

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Guardar cambios</button>
        @Html.ActionLink("Cancelar", "Details", new { id = Model.Id }, new { @class = "btn btn-link" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
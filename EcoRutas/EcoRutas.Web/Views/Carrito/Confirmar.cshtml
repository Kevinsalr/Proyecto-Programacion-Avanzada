@model EcoRutas.Web.Models.ConfirmarReservaViewModel
@{
    ViewBag.Title = "Confirmar reserva";
}

<h2>Confirmar reserva</h2>
<p class="text-muted">Indique el nombre y la identificación de cada pasajero. Cada uno recibirá su propio pase.</p>

@using (Html.BeginForm("Confirmar", "Carrito", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    for (var i = 0; i < Model.Lineas.Count; i++)
    {
        var linea = Model.Lineas[i];
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span><strong>@linea.TourNombre</strong> · @linea.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                <span>@linea.Pasajeros.Count × @linea.PrecioXPersona.ToString("N2")</span>
            </div>
            <div class="card-body">
                @Html.HiddenFor(m => m.Lineas[i].SalidaId)

                @for (var j = 0; j < linea.Pasajeros.Count; j++)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-md-1 pt-2 text-muted">#@(j + 1)</div>
                        <div class="col-md-6">
                            @Html.TextBoxFor(m => m.Lineas[i].Pasajeros[j].Nombre, new { @class = "form-control", placeholder = "Nombre completo" })
                            @Html.ValidationMessageFor(m => m.Lineas[i].Pasajeros[j].Nombre, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-5">
                            @Html.TextBoxFor(m => m.Lineas[i].Pasajeros[j].Identificacion, new { @class = "form-control", placeholder = "Identificación" })
                            @Html.ValidationMessageFor(m => m.Lineas[i].Pasajeros[j].Identificacion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4">
        @Html.ActionLink("Volver al carrito", "Index", null, new { @class = "btn btn-link" })
        <div>
            <span class="me-3">Total: <strong>@Model.Total.ToString("N2")</strong></span>
            <button type="submit" class="btn btn-success">Confirmar reserva</button>
        </div>
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

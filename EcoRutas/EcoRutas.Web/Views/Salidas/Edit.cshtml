@model EcoRutas.Web.Models.SalidaFormViewModel
@{
    ViewBag.Title = "Editar salida";
}

<h2>Editar salida</h2>
<p class="text-muted">Tour: <strong>@Model.TourNombre</strong></p>

@using (Html.BeginForm("Edit", "Salidas", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.Partial("_SalidaCampos", Model)

    <div class="mt-4">
        <button type="submit" class="btn btn-success">Guardar cambios</button>
        @Html.ActionLink("Cancelar", "Details", "Tours", new { id = Model.TourId }, new { @class = "btn btn-link" })
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}